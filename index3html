form.addEventListener('submit',async e=>{
 e.preventDefault();
 clearTimeout(timer);
 await save();
 if(!form.reportValidity())return;
 try{
  showNotice('Enviando a Google Sheets...','');
  const d=snap();
  d.submissionId=(typeof crypto!=='undefined'&&crypto.randomUUID)?crypto.randomUUID():('sub-'+Date.now()+'-'+Math.random().toString(36).slice(2));

  // GitHub Pages no puede leer la respuesta de Apps Script por CORS.
  // Enviamos el POST mediante un formulario oculto para que el navegador
  // lo entregue directamente a Apps Script sin abrir el correo.
  let frame=document.getElementById('sheetPostFrame');
  if(!frame){
    frame=document.createElement('iframe');
    frame.id='sheetPostFrame';
    frame.name='sheetPostFrame';
    frame.style.display='none';
    document.body.appendChild(frame);
  }

  const postForm=document.createElement('form');
  postForm.method='POST';
  postForm.action=SERVER_ENDPOINT;
  postForm.target='sheetPostFrame';
  postForm.style.display='none';

  Object.entries(d).forEach(([k,v])=>{
    const input=document.createElement('input');
    input.type='hidden';
    input.name=k;
    input.value=Array.isArray(v)?v.join(', '):String(v);
    postForm.appendChild(input);
  });

  document.body.appendChild(postForm);
  postForm.submit();
  postForm.remove();

  // Damos un pequeño margen para que Apps Script reciba el POST.
  await new Promise(resolve=>setTimeout(resolve,1200));

  showNotice('✅ Enviado a Google Sheets<br>Descargando PDF...','ok');
  const pdfOk=await downloadPDF();
  if(!pdfOk)throw Error('Los datos se guardaron en Google Sheets, pero no se pudo generar el PDF. Tus datos siguen guardados.');

  await clearDraft();
  form.reset();
  progress();
  showNotice('✅ Completado · Google Sheets actualizado + PDF descargado','ok');
 }catch(err){
  console.error('Error enviando:',err);
  await save();
  showNotice('<b>❌ No se ha podido completar el envío</b><br>'+err.message+'<br>Tus datos siguen guardados y puedes volver a intentarlo.','err');
 }
});
window.addEventListener('pagehide',()=>{if(meaningful(snap()))lsPut(snap())});
